+function opaqueBounds(canvas: { width: number; height: number; getContext(type: '2d'): { getImageData(x: number, y: number, w: number, h: number): { data: Uint8ClampedArray } } }) {
+  const data = canvas.getContext('2d').getImageData(0, 0, canvas.width, canvas.height).data
+  let minX = Infinity
+  let minY = Infinity
+  let maxX = -1
+  let maxY = -1
+  for (let y = 0; y < canvas.height; y++) {
