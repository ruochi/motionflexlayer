+/** 角度。`12` 或 `12deg`。无法解析返回 undefined。 */
+export function parseAngle(value: string | undefined): number | undefined {
+  if (value == null) return undefined
+  const m = /^\s*(-?\d*\.?\d+)\s*(deg)?\s*$/i.exec(value)
+  if (!m) return undefined
+  const n = Number.parseFloat(m[1]!)
+  return Number.isFinite(n) ? n : undefined
+}
+
+/** 行内平移。一个长度是 x，两个是 x y。可带 px。无法解析返回 undefined。 */
+export function parseTranslate(value: string | undefined): { x: number; y: number } | undefined {
+  if (value == null) return undefined
+  const parts = value.trim().split(/[\s,]+/).filter(Boolean)
+  if (parts.length === 0 || parts.length > 2) return undefined
+  const x = parsePx(parts[0])
+  if (x == null) return undefined
+  if (parts.length === 1) return { x, y: 0 }
+  const y = parsePx(parts[1])
+  if (y == null) return undefined
+  return { x, y }
+}
